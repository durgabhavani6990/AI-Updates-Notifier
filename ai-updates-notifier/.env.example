# Copy this file to `.env` and fill in real values to test the script on
# your own machine (e.g. `python main.py`) before trusting it to GitHub
# Actions. This file is ONLY for local testing -- GitHub Actions ignores it
# entirely and uses the repo's Actions secrets instead (see DEPLOY.md/README.md).
#
# Never commit your real `.env` file -- .gitignore already excludes it.

GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword
RECIPIENT_EMAILS=alice@example.com,bob@example.com

META_WA_PHONE_NUMBER_ID=123456789012345
META_WA_ACCESS_TOKEN=your-permanent-system-user-token
META_WA_TEMPLATE_NAME=daily_ai_updates
META_WA_TEMPLATE_LANG=en
RECIPIENT_WHATSAPP_NUMBERS=919876543210,447700900123

# Optional -- leave blank to use the free auto-shortening fallback instead
GEMINI_API_KEY=
